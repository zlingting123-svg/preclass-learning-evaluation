# Copy to /etc/preclass.env, mode 600, owned by root. Never commit the actual file.
NODE_ENV=production
DEPLOYMENT_MODE=single-host
AUTH_MODE=local-bcrypt
STORAGE_MODE=local-sqlite
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=https://classroom.example.com
STATIC_DIR=/opt/preclass/current/frontend/dist
DB_PATH=/var/lib/preclass/app.sqlite

# Dedicated Python venv for PDF parsing; install backend/scripts/requirements.txt here.
REFERENCE_PYTHON=/opt/preclass/python/bin/python
BACKUP_DIR=/var/backups/preclass
# Keep model and web calls disabled until configured and verified.
AI_MODE=disabled

# Per chunk request time, not the whole file or background parsing time.
HTTP_REQUEST_TIMEOUT_MS=120000
