[Unit]
Description=Prefetch bounded MEE official reference documents (no model calls)
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=preclass
Group=preclass
WorkingDirectory=/opt/preclass/tools
Environment=MEE_CACHE_DIR=/var/lib/preclass/official-cache
ExecStart=/opt/preclass/modules/knowledge-map-v1/venv/bin/python /opt/preclass/tools/mee-cache-worker.py
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/preclass/official-cache
