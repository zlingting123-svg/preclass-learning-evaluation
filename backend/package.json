{
  "name": "preclass-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/backend/src/server.js",
    "test": "tsx --test test/*.test.ts",
    "smoke": "node test/startup-smoke.mjs",
    "user:create": "tsx src/manage.ts user",
    "backup": "tsx src/manage.ts backup",
    "worker": "tsx src/worker-main.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
