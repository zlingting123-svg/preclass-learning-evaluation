# Copy to /etc/preclass.env, mode 600, owned by root. Never commit the actual file.
NODE_ENV=production
DEPLOYMENT_MODE=single-host
AUTH_MODE=local-bcrypt
STORAGE_MODE=local-sqlite
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=https://classroom.example.com
STATIC_DIR=/opt/preclass/current/frontend/dist
DB_PATH=/var/lib/preclass/app.sqlite
