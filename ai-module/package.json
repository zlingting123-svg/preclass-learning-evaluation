{
  "name": "course-ai-module",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/src/server.js",
    "sample:setup": "tsx scripts/sample-setup.ts",
    "dev": "tsx src/server.ts",
    "sample:start": "python3 scripts/sample.py start",
    "sample:stop": "python3 scripts/sample.py stop"
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jose": "6.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "undici": "8.12.3"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  }
}
